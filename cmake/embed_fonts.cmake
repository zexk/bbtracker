# Generates a C++ translation unit embedding font files as byte arrays.
# Run via `cmake -P` from the top-level build; see CMakeLists.txt.
#
# Inputs:
#   FONTS  - symbol=path entries joined with `|`
#   OUTPUT - generated .cpp path

if(NOT FONTS OR NOT OUTPUT)
    message(FATAL_ERROR "embed_fonts.cmake requires FONTS and OUTPUT")
endif()

string(REPLACE "|" ";" entries "${FONTS}")
set(code "// Generated by cmake/embed_fonts.cmake. Do not edit.\n")
foreach(entry IN LISTS entries)
    string(REPLACE "=" ";" parts "${entry}")
    list(GET parts 0 symbol)
    list(GET parts 1 path)
    file(SIZE "${path}" size)
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND code
        "extern const unsigned int ${symbol}_size = ${size};\n"
        "extern const unsigned char ${symbol}[] = {${bytes}};\n")
endforeach()
file(WRITE "${OUTPUT}" "${code}")
